APP_NAME=Project Odin
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","app://odin"]
DESKTOP_HOST=127.0.0.1
DESKTOP_PORT=8000

POSTGRES_DB=odin
POSTGRES_USER=odin
POSTGRES_PASSWORD=replace_with_a_local_secret
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Docker/development database. Never commit a real password.
DATABASE_URL=postgresql+asyncpg://odin:replace_with_a_local_secret@db:5432/odin

# The desktop shell supplies a local SQLite DATABASE_URL at runtime.
# No exchange credentials or live-trading secrets are required or supported.
